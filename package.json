{
  "name": "yuzai-desktop-pet",
  "version": "0.1.0",
  "description": "鱼仔桌面宠物 MVP",
  "author": "CrayonW",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node esbuild.config.mjs",
    "dev": "npm run build && electron .",
    "start": "npm run dev",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:win": "npm run build && electron-builder --win nsis",
    "sprites:from-sheets": "node scripts/slice-reference-sheets.mjs",
    "sprites:aliases": "node scripts/prepare-runtime-sprite-aliases.mjs",
    "sprites:derive-states": "node scripts/derive-state-sprites.mjs",
    "sprites:idle-from-video": "node scripts/build-idle-from-video-reference.mjs",
    "audit:sprites": "node scripts/audit-sprite-actions.mjs",
    "render:hyperframes-actions": "node scripts/render-hyperframes-cat-actions.mjs",
    "validate:hyperframes-actions": "node scripts/validate-hyperframes-cat-actions.mjs",
    "validate:all": "node scripts/validate-all.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:runtime-animations": "node scripts/validate-runtime-animations.mjs",
    "validate:animation-smoothness": "node scripts/validate-animation-smoothness.mjs",
    "validate:animation-director": "node scripts/validate-animation-director.mjs",
    "validate:daily-animation-rotator": "node scripts/validate-daily-animation-rotator.mjs",
    "validate:autonomous-behavior-schedule": "node scripts/validate-autonomous-behavior-schedule.mjs",
    "validate:runtime-behavior-schedule": "node scripts/validate-runtime-behavior-schedule.mjs",
    "validate:runtime-interaction-schedule": "node scripts/validate-runtime-interaction-schedule.mjs",
    "validate:interaction-cooldowns": "node scripts/validate-interaction-cooldowns.mjs",
    "validate:reminder-bubble-controller": "node scripts/validate-reminder-bubble-controller.mjs",
    "validate:manifest-contract": "node scripts/validate-manifest-contract.mjs",
    "validate:manifest-contract:current": "node scripts/manifest-contract.mjs",
    "validate:animation-asset-contract": "node scripts/validate-animation-asset-contract.mjs",
    "validate:animation-intake-checklist": "node scripts/validate-animation-intake-checklist.mjs",
    "validate:origin-video-audit": "node scripts/validate-origin-video-audit.mjs",
    "animations:audit-origin": "node scripts/origin-video-audit.mjs",
    "animations:state-coverage": "node scripts/state-coverage-report.mjs",
    "animations:state-backlog": "node scripts/state-backlog.mjs",
    "animations:behavior-schedule": "node scripts/cat-behavior-schedule.mjs",
    "animations:asset-contract": "node scripts/animation-asset-contract.mjs",
    "kling:generation-batches": "node scripts/kling-generation-batches.mjs",
    "validate:state-coverage-report": "node scripts/validate-state-coverage-report.mjs",
    "validate:state-backlog": "node scripts/validate-state-backlog.mjs",
    "validate:kling-plan-quality": "node scripts/validate-kling-plan-quality.mjs",
    "validate:kling-generation-batches": "node scripts/validate-kling-generation-batches.mjs",
    "validate:kling-batch-plan": "node scripts/validate-kling-batch-plan.mjs",
    "validate:kling-batch-status": "node scripts/validate-kling-batch-status.mjs",
    "validate:kling-batch-intake-checklist": "node scripts/validate-kling-batch-intake-checklist.mjs",
    "validate:kling-preflight": "node scripts/validate-kling-preflight.mjs",
    "validate:kling-auth-diagnostics": "node scripts/validate-kling-auth-diagnostics.mjs",
    "validate:cat-behavior-schedule": "node scripts/validate-cat-behavior-schedule.mjs",
    "validate:capture-plan": "node scripts/validate-capture-plan.mjs",
    "validate:capture-sequence-inspector": "node scripts/validate-capture-sequence-inspector.mjs",
    "capture:inspect": "node scripts/capture-sequence-inspector.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "animations:build-from-origin": "node scripts/build-runtime-animations-from-origin.mjs",
    "animations:intake-checklist": "node scripts/animation-intake-checklist.mjs",
    "kling:generate": "node scripts/kling/generate-video.mjs",
    "kling:generate-batch": "node scripts/kling/generate-batch.mjs",
    "kling:batch-status": "node scripts/kling/batch-status.mjs",
    "kling:batch-intake-checklist": "node scripts/kling-batch-intake-checklist.mjs",
    "kling:preflight": "node scripts/kling-preflight.mjs",
    "kling:auth-check": "node scripts/kling/auth-check.mjs",
    "list:animation-cleanup": "node scripts/list-animation-cleanup-candidates.mjs",
    "video:reference": "node scripts/extract-video-reference.mjs",
    "validate:sprites": "node scripts/validate-cat-sprites.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.crayonw.yuzai",
    "productName": "鱼仔桌面宠物",
    "copyright": "Copyright © 2026 CrayonW",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "dist/assets/runtime/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
