{
  "version": 1,
  "updatedAt": "2026-06-18",
  "purpose": "记录 MVP 必须项的当前可复查证据。此文件用于让 docs/requirements-mvp.md 的验收记录进入机器校验，避免后续实现变更后证据过期。",
  "items": [
    {
      "id": "desktop-visible-animated-cat",
      "status": "verified",
      "requirement": "桌面上能看到一只会动的猫，动作应来自 `assets/origin` 源素材重建后的透明序列帧，不能只显示占位兜底渲染。",
      "evidenceCommands": [
        "npm run validate:runtime-animations",
        "npm run validate:animation-smoothness",
        "npm run capture:inspect -- --sequence-path /private/tmp/yuzai-window-animation.png --count 6 --min-changed-frames 2 --min-width 200 --min-height 200"
      ],
      "evidenceFiles": [
        "assets/runtime/animations/manifest.json",
        "assets/reviews/runtime/wave1-alpha-clean-desktop-capture.png",
        "assets/reviews/runtime/wave2-desktop-capture.png",
        "assets/reviews/runtime/sleep-routine-desktop-capture.png"
      ],
      "notes": "运行时动画必须来自 manifest 引用的透明序列帧；桌面捕获拼图用于复查真实桌面窗口中连续帧变化。"
    },
    {
      "id": "always-on-top-transparent-window",
      "status": "verified",
      "requirement": "桌宠要在所有应用最上层显示，保持透明、无边框、置顶。",
      "evidenceCommands": [
        "npm run typecheck",
        "npm run validate:capture-plan",
        "npm run validate:release"
      ],
      "evidenceFiles": [
        "electron/main.ts",
        "electron/capture-plan.ts",
        "docs/requirements-mvp.md"
      ],
      "notes": "Electron 主窗口配置和桌面捕获计划共同证明 MVP 运行在透明置顶桌面窗口中；发布验证保证打包入口仍可用。"
    },
    {
      "id": "reminder-bubbles",
      "status": "verified",
      "requirement": "定时弹出气泡说话，用于提醒喝水、休息等轻量提醒。",
      "evidenceCommands": [
        "npm run validate:reminder-bubble-controller",
        "npm run validate:reminder-action-bridge",
        "npm run validate:runtime-behavior-schedule"
      ],
      "evidenceFiles": [
        "src/core/behavior/reminder-bubble-controller.ts",
        "scripts/validate-reminder-bubble-controller.mjs",
        "scripts/validate-reminder-action-bridge.mjs",
        "docs/requirements-mvp.md"
      ],
      "notes": "提醒气泡控制器验证启动初始画面不立即显示头顶文字，并保留喝水/休息文案；提醒动作桥接验证提醒语义和动作触发入口。"
    },
    {
      "id": "size-and-position-controls",
      "status": "verified",
      "requirement": "支持角色大小和位置设定调整，至少能重置位置，并能配置或调整显示尺寸。",
      "evidenceCommands": [
        "npm run typecheck",
        "YUZAI_SETTINGS_PATH=/private/tmp/yuzai-settings-test.json YUZAI_TEST_MOVE_MS=500 YUZAI_TEST_MOVE_X=120 YUZAI_TEST_MOVE_Y=140 YUZAI_CAPTURE_DELAY_MS=1300 YUZAI_CAPTURE_PATH=/private/tmp/yuzai-window-settings-persist.png npm run dev"
      ],
      "evidenceFiles": [
        "electron/main.ts",
        "src/renderer/main.ts",
        "docs/requirements-mvp.md"
      ],
      "notes": "主进程菜单、设置持久化和渲染进程窗口交互共同覆盖尺寸档位、位置保存和重置路径。"
    },
    {
      "id": "mouse-proximity-reaction",
      "status": "verified",
      "requirement": "鼠标靠近时有反应，例如看向鼠标、轻微动作、摇尾巴或其他已批准互动动作。",
      "evidenceCommands": [
        "npm run validate:proximity-action-bridge",
        "npm run validate:runtime-interaction-schedule",
        "YUZAI_TEST_MOUSE_PROXIMITY_MS=500 YUZAI_CAPTURE_DELAY_MS=2000 YUZAI_CAPTURE_PATH=/private/tmp/yuzai-window-proximity-paw-raise.png npm run dev"
      ],
      "evidenceFiles": [
        "assets/config/action-bridges.json",
        "scripts/validate-proximity-action-bridge.mjs",
        "docs/runtime-action-bridge-report.md",
        "docs/requirements-mvp.md"
      ],
      "notes": "靠近触发从主进程鼠标轮询进入 renderer，再由 action bridge 选择已批准互动动作。"
    },
    {
      "id": "pose-variation",
      "status": "verified",
      "requirement": "支持姿势变换，至少包含待机、走动、摇尾巴或同等可见变化；后续 13 状态补齐后再统一优化。",
      "evidenceCommands": [
        "npm run validate:manifest-contract:current",
        "npm run validate:daily-animation-rotator",
        "npm run validate:state-coverage-report"
      ],
      "evidenceFiles": [
        "assets/runtime/animations/manifest.json",
        "docs/state-coverage.md",
        "docs/state-backlog.md",
        "assets/reviews/runtime/wave2-runtime-contact-sheet.png"
      ],
      "notes": "manifest 当前覆盖 13 个状态映射，日常 rotator 和状态覆盖报告用于防止姿势变化退回单一待机。"
    },
    {
      "id": "source-material-checklist",
      "status": "verified",
      "requirement": "验收前必须先列出本次源素材、生成动作、覆盖路径和验证方式清单，得到确认后再执行。",
      "evidenceCommands": [
        "npm run validate:animation-intake-checklist",
        "npm run validate:runtime-intake-checklists-current",
        "npm run validate:runtime-intake-approvals-current"
      ],
      "evidenceFiles": [
        "docs/animation-intake-current.md",
        "docs/runtime-intake-waves.json",
        "docs/runtime-intake-wave1-execution-checklist.md",
        "docs/runtime-intake-wave2-execution-checklist.md",
        "docs/runtime-intake-sleep-routine-execution-checklist.md",
        "docs/runtime-intake-dragging-special-execution-checklist.md"
      ],
      "notes": "新增素材和 runtime 波次都必须先产出中文清单；正式执行还要通过批准文件门禁。"
    }
  ]
}
